<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".introduction">

    <TextView
        android:id="@+id/viewTerms"
        android:text="選択されている条件"
        android:textSize="30dp"
        android:layout_width="350dp"
        android:layout_height="50dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/imageStore"/>

    <TextView
        android:id="@+id/viewSelectedGenre"
        android:text="選択されたジャンルはここに表示"
        android:textSize="20dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/viewTerms"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageView
        android:id="@+id/imageStore"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/viewTerms"
        app:layout_constraintBottom_toBottomOf="parent" />

    <TextView
        android:id="@+id/searchingText"
        android:text="検索中..."
        android:textSize="18dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/viewSelectedGenre"
        app:layout_constraintEnd_toEndOf="parent" />
    <!--
    <TextView
        android:id="@+id/viewStoreTitle"
        android:text="店名"
        android:textSize="50dp"
        android:layout_width="match_parent"
        android:layout_height="50dp" /
        -->

</androidx.constraintlayout.widget.ConstraintLayout>